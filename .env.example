# AI Services (Required for image generation)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Rate Limiting (Optional)
# GEMINI_TIER: "free" (default), "paid" (Tier 1), or "tier2" (Tier 2 - $250+ spend)
GEMINI_TIER=free
# Legacy: GEMINI_PAID_TIER=true is equivalent to GEMINI_TIER=paid
GEMINI_PAID_TIER=false

# Persistence (Optional - falls back to localStorage if not configured)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
